# Log Enrichment - Environment Variables
# Copy this file to .env and fill in the values

# IP-API Key (optional, for paid plan - unlimited queries)
IPAPI_KEY=

# Application password (optional, leave empty to disable auth — not recommended in production)
# Prefer AUTH_PASSWORD_HASH with Argon2 (python scripts/gen_auth_password_hash.py)
# AUTH_PASSWORD is plaintext (dev only). Legacy SHA-256 hex still accepted in AUTH_PASSWORD_HASH.
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=

# Timezone offset from UTC (default: -3 for Brazil)
TZ_OFFSET_HOURS=-3
# Custom timezone label (optional, auto-generated from offset)
# TZ_LABEL=GMT -0300

# VirusTotal API Key (free tier: 4 req/min)
# Get yours at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key (free tier: 1000 checks/day)
# Get yours at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan API Key (service/port scanning)
# Get yours at: https://account.shodan.io
SHODAN_API_KEY=

# Folder to monitor for auto-processing (optional)
WATCH_FOLDER=

# Optional HMAC secret for audit trail (HMAC-SHA256 over event_hash)
# Generate a long random string; keep offline / in secrets manager
AUDIT_HMAC_SECRET=

# Optional HMAC for signed IP cache packages (defaults to AUDIT_HMAC_SECRET)
CACHE_HMAC_SECRET=
# When true, salvar_cache writes signed envelope to ip_cache.json
SIGN_IP_CACHE=false

# Air-gapped mode: no external IP-API HTTP (cache-only enrichment)
AIR_GAPPED=false

# Retention (startup + scripts/retention_cleanup.py)
RETENTION_ON_STARTUP=true
RETENTION_AUDIT_DAYS=90
RETENTION_AUDIT_MAX_LINES=50000
RETENTION_SESSIONS_DAYS=30
RETENTION_CACHE_DAYS=30
