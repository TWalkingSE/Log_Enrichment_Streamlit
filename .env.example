# Log Enrichment - Environment Variables
# Copy this file to .env and fill in the values

# IP-API Key (optional, for paid plan - unlimited queries)
IPAPI_KEY=

# Application password (optional, leave empty to disable auth)
# Use AUTH_PASSWORD for plaintext or AUTH_PASSWORD_HASH for SHA-256 hash
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=

# Timezone offset from UTC (default: -3 for Brazil)
TZ_OFFSET_HOURS=-3
# Custom timezone label (optional, auto-generated from offset)
# TZ_LABEL=GMT -0300

# VirusTotal API Key (free tier: 4 req/min)
# Get yours at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key (free tier: 1000 checks/day)
# Get yours at: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan API Key (service/port scanning)
# Get yours at: https://account.shodan.io
SHODAN_API_KEY=

# Folder to monitor for auto-processing (optional)
WATCH_FOLDER=
